{
  "name": "applyready-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "node scripts/run-dev.js",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "desktop:dev": "npm run build && node scripts/run-desktop.js",
    "desktop:pack": "npm run build && node scripts/package-desktop.js"
  },
  "main": "desktop/main.cjs",
  "description": "A private student opportunity readiness workspace.",
  "author": "ApplyReady AI",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  }
}
